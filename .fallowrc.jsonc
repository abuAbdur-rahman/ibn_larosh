{
  // Fallow (codebase analyzer) configuration.
  // https://fallow.tools/docs/configuration

  // shadcn-generated primitives are a vendored component library, not our
  // code. Treating them as roots keeps them (and the packages they import)
  // out of dead-code findings until pages consume them in Phase 3.
  "entry": ["src/components/ui/**/*.tsx"],

  "health": {
    // Vendored primitives are not ours to refactor.
    "ignore": ["src/components/ui/**"],

    // CRAP = CC² × (1 − coverage)³ + CC. With no test harness yet, coverage is
    // estimated at 0, so this is just CC² + CC. Keep the real complexity gates
    // strict (cyclomatic 20, cognitive 15) and allow CC ≤ 7 here until tests +
    // coverage reporting land in Phase 4.
    "maxCrap": 60
  }
}
