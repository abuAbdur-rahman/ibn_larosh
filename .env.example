# ── Site ────────────────────────────────────────────────────────────
# Canonical origin for absolute URLs in metadata (no trailing slash).
# Optional: on Vercel the production URL is derived automatically.
NEXT_PUBLIC_SITE_URL=

# ── Database (Neon Postgres, pooled connection string) ───────────────
DATABASE_URL=

# ── Admin portal auth (single admin; change both for production) ─────
ADMIN_USERNAME=admin
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PASSWORD=
# 32+ bytes hex, signs the HttpOnly session cookie
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Cloudflare R2 (S3-compatible, credentials stay server-side) ──────
# Cap photos are streamed through /api/media/<key>, so the bucket can stay
# private — no public bucket URL or custom domain is required.
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bn-laroosh
