# ── Database (Neon Postgres, pooled connection string) ───────────────
DATABASE_URL=

# ── Admin portal auth (single admin; change both for production) ─────
ADMIN_USERNAME=admin
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
ADMIN_PASSWORD=
# 32+ bytes hex, signs the HttpOnly session cookie
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Cloudflare R2 (S3-compatible, browser never sees keys) ───────────
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ibn-larosh-caps
# Public bucket URL (r2.dev or img.ibnlarosh.com) — no trailing slash
R2_PUBLIC_BASE_URL=